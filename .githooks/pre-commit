#!/usr/bin/env bash

echo "Running Spotless..."

# Remember which files were staged before running the checks.
staged_files=$(git diff --cached --name-only)

mvn initialize spotless:apply
status=$?

# Restage only files that were originally staged.
if [ -n "$staged_files" ]; then
    echo "$staged_files" | xargs -r git add --
fi

if [ $status -ne 0 ]; then
    echo "Spotless/checkstyle failed. Commit aborted."
    exit 1
fi

exit 0
