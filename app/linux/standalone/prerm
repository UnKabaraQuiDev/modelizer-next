#!/bin/sh
set -e

APP_BIN_DIR="/opt/modelizer-next-app/bin"
TARGET="$APP_BIN_DIR/Modelizer Next App"
BIN_LINK="/usr/bin/modelizer-next"
OPTIONAL_BIN_LINK="/usr/bin/modelizer-next-app"
DESKTOP_LINK="/usr/share/applications/modelizer-next-APP.desktop"

if [ -L "$BIN_LINK" ]; then
    rm -f "$BIN_LINK"
fi

if [ -L "$OPTIONAL_BIN_LINK" ] && [ "$(readlink "$OPTIONAL_BIN_LINK")" = "$TARGET" ]; then
    rm "$OPTIONAL_BIN_LINK"
fi

if [ -L "$DESKTOP_LINK" ]; then
    rm -f "$DESKTOP_LINK"
fi

update-desktop-database /usr/share/applications || true

exit 0